# Login of the admin (sees everything)
AUTH_USERNAME=gustavo
# Output of `npm run hash-password`
AUTH_PASSWORD_HASH=
# Users that only see the Prompts tab: JSON list of {"username", "name", "password_hash"}
AUTH_PROMPT_USERS=[]
# Random string with at least 32 characters: `openssl rand -base64 48`
AUTH_SECRET=

# MongoDB Atlas (read, plus insert in prompt_inputs)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DATABASE=personal_whats
